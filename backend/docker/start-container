#!/bin/sh
set -eu

: "${PORT:=10000}"
envsubst '${PORT}' < /etc/nginx/http.d/default.conf.template > /etc/nginx/http.d/default.conf

php artisan migrate --force

# Bootstrap is intentionally opt-in: after the one-time password is removed,
# retained admin metadata must not make future deploys fail.
if [ -n "${OPEN_BETA_ADMIN_EMAIL:-}" ] && [ -n "${OPEN_BETA_ADMIN_PASSWORD:-}" ]; then
  php artisan marketplace:bootstrap-admin
fi

php artisan config:cache
php artisan route:cache

exec /usr/bin/supervisord -c /etc/supervisord.conf
