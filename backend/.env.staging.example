APP_NAME=TalentXpanse Staging
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-staging.example.com
FRONTEND_URL=https://staging.example.com

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talentxpanse_staging
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
MARKETPLACE_MEMBER_SESSION_MINUTES=480
MARKETPLACE_ADMIN_SESSION_MINUTES=30

QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
DB_QUEUE_CONNECTION=mysql
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=120

MAIL_MAILER=failover
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello-staging@example.com
MAIL_FROM_NAME=TalentXpanse Staging
MARKETPLACE_EMAIL_NOTIFICATIONS_ENABLED=true

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=api-staging.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=https://staging.example.com

MARKETPLACE_PAYMENT_CURRENCY=MMK
MARKETPLACE_PLATFORM_FEE_BASIS_POINTS=1000
MARKETPLACE_PAYMENTS_ENABLED=false
MARKETPLACE_PAYMENT_PROVIDER=
