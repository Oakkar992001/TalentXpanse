APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

GOOGLE_CLIENT_ID=
MARKETPLACE_PAYMENT_CURRENCY=MMK
MARKETPLACE_PLATFORM_FEE_BASIS_POINTS=1000
MARKETPLACE_PAYMENTS_ENABLED=false
MARKETPLACE_PAYMENT_PROVIDER=
MARKETPLACE_OFFER_EXPIRY_DAYS=7

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
MARKETPLACE_MEMBER_SESSION_MINUTES=480
MARKETPLACE_ADMIN_SESSION_MINUTES=30

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
FILESYSTEM_DISK=local
MARKETPLACE_PRIVATE_FILESYSTEM_DISK=local
MARKETPLACE_PUBLIC_FILESYSTEM_DISK=public
MARKETPLACE_REQUIRE_EXTERNAL_STORAGE=false
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MARKETPLACE_EMAIL_NOTIFICATIONS_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MARKETPLACE_PRIVATE_AWS_ACCESS_KEY_ID=
MARKETPLACE_PRIVATE_AWS_SECRET_ACCESS_KEY=
MARKETPLACE_PRIVATE_AWS_DEFAULT_REGION=auto
MARKETPLACE_PRIVATE_AWS_BUCKET=
MARKETPLACE_PRIVATE_AWS_ENDPOINT=
MARKETPLACE_PRIVATE_AWS_USE_PATH_STYLE_ENDPOINT=true

MARKETPLACE_PUBLIC_AWS_ACCESS_KEY_ID=
MARKETPLACE_PUBLIC_AWS_SECRET_ACCESS_KEY=
MARKETPLACE_PUBLIC_AWS_DEFAULT_REGION=auto
MARKETPLACE_PUBLIC_AWS_BUCKET=
MARKETPLACE_PUBLIC_AWS_URL=
MARKETPLACE_PUBLIC_AWS_ENDPOINT=
MARKETPLACE_PUBLIC_AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
