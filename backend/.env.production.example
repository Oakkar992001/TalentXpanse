APP_NAME=TalentXpanse
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talentxpanse
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
MARKETPLACE_MEMBER_SESSION_MINUTES=480
MARKETPLACE_ADMIN_SESSION_MINUTES=30

QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
DB_QUEUE_CONNECTION=mysql
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=120
BROADCAST_CONNECTION=reverb

MAIL_MAILER=failover
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=TalentXpanse
MARKETPLACE_EMAIL_NOTIFICATIONS_ENABLED=true

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=api.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=https://app.example.com

MARKETPLACE_PAYMENT_CURRENCY=MMK
MARKETPLACE_PLATFORM_FEE_BASIS_POINTS=1000
MARKETPLACE_PAYMENTS_ENABLED=false
MARKETPLACE_PAYMENT_PROVIDER=

# Use separate R2/S3 disks when the application filesystem is not durable.
MARKETPLACE_PRIVATE_FILESYSTEM_DISK=local
MARKETPLACE_PUBLIC_FILESYSTEM_DISK=public
MARKETPLACE_REQUIRE_EXTERNAL_STORAGE=false
