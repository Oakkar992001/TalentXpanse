APP_NAME=TalentXpanse
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-api.onrender.com
FRONTEND_URL=https://your-site.pages.dev
CORS_ALLOWED_ORIGINS=https://your-site.pages.dev

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
MARKETPLACE_MEMBER_SESSION_MINUTES=480
MARKETPLACE_ADMIN_SESSION_MINUTES=30

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
BROADCAST_CONNECTION=log

MARKETPLACE_PAYMENT_CURRENCY=MMK
MARKETPLACE_PLATFORM_FEE_BASIS_POINTS=1000
MARKETPLACE_PAYMENTS_ENABLED=false
MARKETPLACE_EMAIL_NOTIFICATIONS_ENABLED=false

# Keep email in the Laravel log during the beta until an owned sender domain is verified.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TalentXpanse

GOOGLE_CLIENT_ID=

# Set these once for the first deployment, then remove OPEN_BETA_ADMIN_PASSWORD.
OPEN_BETA_ADMIN_NAME=TalentXpanse Administrator
OPEN_BETA_ADMIN_EMAIL=
OPEN_BETA_ADMIN_PASSWORD=

MARKETPLACE_PRIVATE_FILESYSTEM_DISK=marketplace_private
MARKETPLACE_REQUIRE_EXTERNAL_STORAGE=true
MARKETPLACE_PRIVATE_AWS_ACCESS_KEY_ID=
MARKETPLACE_PRIVATE_AWS_SECRET_ACCESS_KEY=
MARKETPLACE_PRIVATE_AWS_DEFAULT_REGION=YOUR_SUPABASE_REGION
MARKETPLACE_PRIVATE_AWS_BUCKET=talentxpanse-private
MARKETPLACE_PRIVATE_AWS_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
MARKETPLACE_PRIVATE_AWS_USE_PATH_STYLE_ENDPOINT=true

MARKETPLACE_PUBLIC_FILESYSTEM_DISK=marketplace_public
MARKETPLACE_PUBLIC_AWS_ACCESS_KEY_ID=
MARKETPLACE_PUBLIC_AWS_SECRET_ACCESS_KEY=
MARKETPLACE_PUBLIC_AWS_DEFAULT_REGION=YOUR_SUPABASE_REGION
MARKETPLACE_PUBLIC_AWS_BUCKET=talentxpanse-public
MARKETPLACE_PUBLIC_AWS_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/talentxpanse-public
MARKETPLACE_PUBLIC_AWS_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
MARKETPLACE_PUBLIC_AWS_USE_PATH_STYLE_ENDPOINT=true
